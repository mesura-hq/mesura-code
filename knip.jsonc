{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of our contracts even before they have consumers.
  //
  // Mesura: `exports` and `nsExports` are off for the same reason, but with a
  // debt attached rather than a principle. Knip arrived with v0.0.42, so its
  // `--exports` pass met this fork's accumulated surface all at once: 46
  // exported-but-unreferenced values across the dictation broker, the file
  // manager, the editor session, the usage readers, the Monaco surface and the
  // pane navigation — every one of them a fork-owned module upstream's check was
  // never written against. Most are exported for a test that no longer imports
  // them, or used only inside their own file.
  //
  // Turning the rule on is the goal; doing it as part of a 143-conflict sync is
  // how a sync stops landing. Tracked in .factory/upstream-sync-ledger.md with
  // the list, to be worked down in its own change.
  "rules": { "types": "off", "nsTypes": "off", "exports": "off", "nsExports": "off" },
  // These executables are supplied by the OS or installed separately from npm.
  "ignoreBinaries": ["eas", "file", "mkfifo", "pkill", "pkg-config", "plutil", "sips"],
  "workspaces": {
    ".": {
      // Keep vendored reference repositories outside the root project.
      "project": ["*.{js,mjs,cjs,ts,mts,cts}", ".github/**/*.cjs"],
      "entry": [
        // CodeRabbit loads its configuration by filename.
        ".coderabbit.config.ts",
        ".github/scripts/thread-transfer-report.cjs",
      ],
      "vite": { "entry": [".github/**/*.test.cjs"] },
      "vitest": { "entry": [".github/**/*.test.cjs"] },
    },
    "scripts": {
      // Knip loads its preprocessor through a CLI option; native verification and
      // worktree setup (from t3.json) run directly. release-desktop.yml bundles the
      // Windows verify script with esbuild through a path knip does not trace, and
      // electron-builder loads the macOS signer by path. The upstream sync runs
      // remove-native-mobile.ts directly (ADR-008). Agents run mesura-checks.ts
      // (AGENTS.md's Deterministic Checks) and mesura-browser.ts directly.
      "entry": [
        // These fixture scripts are injected into a browser page by path.
        "fixtures/*/*.js",
        "knip-schemas.ts",
        "remove-native-mobile.ts",
        "mesura-checks.ts",
        "mesura-browser.ts",
        "setup-worktree.ts",
        "sign-macos.ts",
        "verify-windows-desktop-artifact.ts",
        // Chromium fixture builders load these Vite library entries by path.
        "lib/mesura-panel.launcher.fixture.mjs",
        "lib/mesura-timeline.find.fixture.mjs",
      ],
      "ignoreDependencies": ["esbuild"],
      // The `t3` npm package's files: copied into the package, never imported.
      // knip-schemas.test.ts writes a throwaway project to .knip-test-*, which a
      // knip run beside it in check:changed must not report.
      "ignore": ["npm-launcher/**", ".knip-test-*/**"],
    },
    "apps/server": {
      // Vite+ pack entries and the launcher used by installed background services.
      "entry": [
        "src/bin.ts!",
        "src/claude-history-worker.ts!",
        "scripts/cli.ts",
        "scripts/evaluate-thread-titles.ts",
        "scripts/fetch-expo-schema.ts",
        "scripts/probe-claude-fork-local-rollback-replay.ts",
        "scripts/update-test-shard-weights.ts",
        "scripts/verify-background-live.ts",
        "src/provider/testFixtures/*.mjs",
        // graphqlgen reads its config.
        "graphql.config.ts",
      ],
      // Retain upstream helpers and fallback layers that currently have no callers.
      // Exempt only export/duplicate reports; keep dependency analysis for these modules.
      "ignoreIssues": {
        "**/*.graphql.ts": ["exports", "types", "namespaceMembers"],
        "src/orchestration-v2/Orchestrator.ts": ["exports", "nsExports", "duplicates"],
        "src/orchestration-v2/Adapters/CodexAdapterV2.ts": ["exports", "nsExports", "duplicates"],
        "src/orchestration-v2/Adapters/ClaudeAdapterV2.ts": ["exports", "nsExports", "duplicates"],
        "src/orchestration-v2/ProviderAdapterRegistry.ts": ["exports", "nsExports", "duplicates"],
        "src/scheduledTasks/Schedule.ts": ["exports", "nsExports", "duplicates"],
        "src/usage/UsageService.ts": ["exports", "nsExports", "duplicates"],
        "src/orchestration-v2/EffectWorker.ts": ["exports", "nsExports", "duplicates"],
      },
      // Keep the transitive Effect runtime pinned for standalone npm installs.
      // The Vite+ web build prerequisite.
      // Native and disk-loaded provider packages stay external to the bundle; the
      // CLI archive and desktop sidecar stage them from this manifest.
      "ignoreDependencies": ["@effect/platform-node-shared", "@t3tools/web", "@napi-rs/keyring"],
    },
    "apps/desktop": {
      // Electron loads these bundles by filename rather than importing them.
      "entry": [
        "gnome-extension/extension.js!",
        "src/electron/WindowsForegroundFocusWorker.ts!",
        "src/snapShot/GlobalShiftShortcutWorker.ts!",
        "src/snapShot/RegionSnapShotWorker.ts!",
        "src/snapShot/SnapShotAccessibilityWorker.ts!",
        "src/boot.ts!",
        "src/compileCache.ts!",
        "src/main.ts!",
        "src/preload.ts!",
        "src/preview-pick-preload.ts!",
        "src/preview-pip-preload.ts!",
        "src/mac-permission-preload.ts!",
        "src/preview/Annotation.css!",
      ],
      // The injected runtime resolves Playwright by string; release tooling runs
      // electron-builder from this workspace, outside its package scripts.
      "ignoreDependencies": ["playwright-core", "electron-builder"],
    },
    "apps/web": {
      // Worktree setup (scripts/setup-worktree.ts) runs this directly, and evidence
      // fixtures run under node.
      "entry": ["scripts/warm-dep-cache.ts", "test/fixtures/**/*.mjs"],
      // UI component modules are copied and adapted as cohesive sets. Keep their
      // named subcomponents even before they have callers; the file audit still
      // reports an entire component module when nothing imports it.
      "ignoreIssues": { "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"] },
      // Mesura: upstream renders these; this fork does not, and keeping the
      // files is deliberate. `GitActionsControl` and the `StartTruncatedPath` it
      // uses were the chat header's git quick action, which this fork moved out of
      // the header; `useDirectoryEntries` belongs to upstream's file explorer,
      // which this fork replaced with the Symmetria tree. The two
      // `BranchToolbar*Selector` files were the strip's host and workspace menus,
      // which the run context drawer replaced. Deleting them would be the change
      // most likely to conflict at the next sync — upstream still edits all of
      // them — so they stay, unrendered, and knip is told why.
      "ignore": [
        "src/components/GitActionsControl.tsx",
        "src/components/StartTruncatedPath.tsx",
        "src/components/files/useDirectoryEntries.ts",
        // Upstream's file explorer uses this batch helper; the Symmetria tree owns this path here.
        "src/components/files/fileTreePathReconciliation.ts",
        "src/components/BranchToolbarEnvironmentSelector.tsx",
        "src/components/BranchToolbarEnvModeSelector.tsx",
      ],
    },
    "apps/marketing": {
      // `astro check` runs from the typecheck task in vite.config.ts, which knip does not read.
      "ignoreDependencies": ["@astrojs/check"],
    },
    "infra/task-cache": {
      "ignore": ["vendor/**"],
      // The bootstrap and Vite+ hook are loaded by shell/package configuration.
      "entry": [
        "alchemy.run.ts!",
        "scripts/install.ts",
        "scripts/install-ci.ts",
        "src/runHook.ts",
        "src/flush.ts",
        "src/nativeRunHook.js",
        "src/preload.mjs",
      ],
    },
    "infra/relay": {
      "entry": ["alchemy.run.ts!", "src/persistence/schema.ts!"],
    },
    "packages/*": {
      // These workspace packages are private to this monorepo.
      "includeEntryExports": true,
    },
    // Mesura: the vendored file manager. Its own knip.json already declares these
    // two as entries, but a run from the repo root reads this config alone, so the
    // declaration has to be repeated here. Both are worker entry points that
    // `app/scripts/build.mjs` loads by path rather than importing.
    "vendor/symmetria-file-manager/packages/fm-search": {
      "entry": ["src/main/worker-entry.ts!", "src/main/worker-entry-electron.ts!"],
    },
    "packages/effect-acp": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      // Generated upstream protocol definitions are retained as a complete set.
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
    "packages/effect-codex-app-server": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
    "packages/source-control-github": {
      // graphqlgen reads its config; the generated operations export every selection's class.
      "entry": ["graphql.config.ts", "scripts/measure-pr-preview.ts"],
      "ignoreIssues": { "**/*.graphql.ts": ["exports", "types", "namespaceMembers"] },
    },
  },
}
