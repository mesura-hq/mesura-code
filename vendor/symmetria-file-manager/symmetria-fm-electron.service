[Unit]
Description=Symmetria File Manager (Electron build)
# The Qt daemon can start at `default.target` safely because it opens NO window
# until something asks it to. This one paints a window as soon as it starts, so
# it needs the Wayland socket immediately. A unit that starts before the
# graphical session either dies in a restart loop or serves windows that never
# appear — and the second failure looks like a broken application rather than a
# broken unit.
#
# The session must also have made WAYLAND_DISPLAY visible to the user manager,
# with `systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP`
# or Hyprland's exec-once equivalent. Check with `systemctl --user show-environment`.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/symmetria-fm-electron
# Strip Hyprland's stale initial-workspace token before exec.
#
# THIS LINE IS LOAD-BEARING and is carried over from the Qt unit verbatim,
# including this explanation. systemd starts this daemon once at login, on
# whatever workspace was active then, and it inherits HL_INITIAL_WORKSPACE_TOKEN
# from the session environment. Hyprland reads that token from
# /proc/<pid>/environ and — with misc:initial_workspace_tracking at its default
# — routes the daemon's FIRST window to the token's recorded workspace instead
# of where the rule says. The symptom is that the very first file-manager window
# after every login lands somewhere else.
#
# The unset MUST happen before exec: /proc/<pid>/environ is the exec-time
# environment block, so an in-process unsetenv() would already be too late.
# See Hyprland issue #5919.
UnsetEnvironment=HL_INITIAL_WORKSPACE_TOKEN
Restart=always
RestartSec=2

# The two exits that cannot be fixed by trying again.
#
#   69  EX_UNAVAILABLE — another daemon already holds the socket.
#   78  EX_CONFIG      — the application directory is gone.
#
# Observed, the first time this unit was started for real: an Electron process
# from a previous start survived outside the service's cgroup and kept the
# socket, so every restart correctly refused and was restarted again. Six times
# in twenty seconds, each paying a full Electron boot, with the journal filling
# up with a message that was telling the truth. `Restart=always` plus a correct
# liveness check is an infinite loop, and the check is the half that is right.
#
# **This line said `1` first, and that was worse than the loop.** Node exits 1
# for an uncaught exception and the launcher exits 1 on a failed build, so
# preventing restarts on 1 also told systemd to give up after a real crash —
# the exact thing `Restart=always` exists to handle. Review caught it. Every
# code named here is now produced by exactly one deliberate, permanent
# condition, and everything else still restarts.
RestartPreventExitStatus=69 78

# Kill the process systemd cannot see, because Chromium moved it out of reach.
#
# Observed on the first real start: `systemctl --user stop` left the daemon
# running and holding the socket, so the next start refused (correctly) and the
# unit restart-looped. The cause is Chromium's own behaviour — on a systemd user
# session it relocates its BROWSER process into a transient scope of its own,
# `app-symmetria-fm-electron-<pid>.scope`, so it survives cleanup of whatever
# launched it. That is right for a desktop launch and wrong for a service: the
# service cgroup then holds only the Node wrapper and the zygotes, and stopping
# it reaches everything except the part that matters.
#
# The `-` prefix ignores failure, which is the normal case: on a clean stop the
# scope is already gone and there is nothing to match. Absolute path for the
# same reason the launcher uses one — `ExecStopPost` runs with almost no PATH.
ExecStopPost=-/usr/bin/systemctl --user stop app-symmetria-fm-electron-*.scope

[Install]
WantedBy=graphical-session.target
